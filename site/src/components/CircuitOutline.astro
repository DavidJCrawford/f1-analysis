---
import type { Outline, Corner } from '@lib/types';
import { pointAndNormal } from '@lib/geometry';

interface Props {
  outline: Outline; name: string;
  height?: number; stroke?: number; showStart?: boolean;
  corners?: Corner[]; lapLength?: number;
}
const { outline, name, height = 120, stroke = 1.5, showStart = true,
        corners = [], lapLength } = Astro.props;

const labelled = corners.length > 0 && lapLength != null;
const PAD = labelled ? 0.14 : 0.06;
const span = 1 + PAD * 2;
const px = (x: number) => x + 0.5 + PAD;
const unit = (v: number) => (v / height) * span;   // px -> viewBox units

const d = outline.points
  .map(([x, y], i) => `${i === 0 ? 'M' : 'L'}${px(x).toFixed(4)} ${px(y).toFixed(4)}`)
  .join('') + 'Z';
const [sx, sy] = outline.points[0]!;

const cx = outline.points.reduce((s, q) => s + q[0], 0) / outline.points.length;
const cy = outline.points.reduce((s, q) => s + q[1], 0) / outline.points.length;

/**
 * Every corner gets a number. Labels are pushed out along the local outward
 * normal, and a colliding label is pushed further rather than dropped — a
 * missing number reads as missing data, which is worse than a crowded map.
 * Anything displaced beyond the base offset gets a leader line back to its dot.
 */
const BASE = 13, STEP = 7, MAX = 52;
const box = (n: number) => ({ w: unit(String(n).length * 6.2 + 5), h: unit(11) });

const placed: { x: number; y: number; w: number; h: number }[] = [];
const marks = labelled ? corners.map((c) => {
  const { p, n } = pointAndNormal(outline.points, c.apex / lapLength!, [cx, cy]);
  const dx = px(p[0]), dy = px(p[1]);
  const { w, h } = box(c.n);

  let off = BASE, lx = dx, ly = dy;
  for (; off <= MAX; off += STEP) {
    lx = dx + n[0] * unit(off);
    ly = dy + n[1] * unit(off);
    const clash = placed.some((q) =>
      Math.abs(q.x - lx) < (q.w + w) / 2 && Math.abs(q.y - ly) < (q.h + h) / 2);
    if (!clash) break;
  }
  if (off > MAX) off = MAX;                 // place it anyway; never drop
  placed.push({ x: lx, y: ly, w, h });

  return { n: c.n, dx, dy, lx, ly, leader: off > BASE + STEP,
           nx: n[0], ny: n[1], off };
}) : [];
---
<svg
  class="outline"
  viewBox={`0 0 ${span} ${span}`}
  style={`height:${height}px`}
  role="img"
  aria-label={`Outline of ${name}${corners.length ? `, ${corners.length} corners numbered in lap order` : ''}${showStart ? ', gold marks start and finish' : ''}`}
>
  <path
    d={d} fill="none" stroke="currentColor"
    stroke-width={unit(stroke)} stroke-linejoin="round" stroke-linecap="round"
    vector-effect="non-scaling-stroke"
  />

  {marks.filter((m) => m.leader).map((m) => (
    <line class="leader"
          x1={m.dx + m.nx * unit(3.5)} y1={m.dy + m.ny * unit(3.5)}
          x2={m.lx - m.nx * unit(5)}   y2={m.ly - m.ny * unit(5)} />
  ))}

  {marks.map((m) => <circle class="corner-dot" cx={m.dx} cy={m.dy} r={unit(2.1)} />)}

  {marks.map((m) => (
    <text class="corner-num" x={m.lx} y={m.ly + unit(3.3)}
          text-anchor="middle" style={`font-size:${unit(9.5)}px`}>{m.n}</text>
  ))}

  {showStart && <circle cx={px(sx)} cy={px(sy)} r={unit(2.9)} fill="var(--ks-kinpaku)" />}
</svg>

<style>
  .outline { display: block; width: auto; max-width: 100%; overflow: visible; }
  .outline path { stroke-width: 1.5px; }
  .corner-dot { fill: currentColor; fill-opacity: .55; }
  .corner-num { fill: currentColor; fill-opacity: .78; font-family: var(--ks-mono), monospace; }
  .leader { stroke: currentColor; stroke-opacity: .28; stroke-width: 1; vector-effect: non-scaling-stroke; }
</style>
