---
import type { Outline, Corner } from '@lib/types';
import { pointAndNormal, subPath } from '@lib/geometry';

interface Props {
  outline: Outline; name: string;
  height?: number; stroke?: number; showStart?: boolean;
  corners?: Corner[]; lapLength?: number;
}
const { outline, name, height = 120, stroke = 1.5, showStart = true,
        corners = [], lapLength } = Astro.props;

const marked = corners.length > 0 && lapLength != null;
const PAD = 0.06;
const span = 1 + PAD * 2;
const px = (x: number) => x + 0.5 + PAD;
const unit = (v: number) => (v / height) * span;

const d = outline.points
  .map(([x, y], i) => `${i === 0 ? 'M' : 'L'}${px(x).toFixed(4)} ${px(y).toFixed(4)}`)
  .join('') + 'Z';
const [sx, sy] = outline.points[0]!;
const cx = outline.points.reduce((s, q) => s + q[0], 0) / outline.points.length;
const cy = outline.points.reduce((s, q) => s + q[1], 0) / outline.points.length;

/**
 * The stretch of track each corner occupies, drawn over the base line. These
 * are cornering sections derived from curvature — deliberately NOT numbered.
 * Official turn numbers are a convention assigned by the circuit and the FIA,
 * not a property of the shape: Monza's Variante Ascari is one complex numbered
 * as three turns. Numbering derived sections would assert something the
 * geometry cannot support.
 */
const linkData = marked ? JSON.stringify({
  pts: outline.points.map(([x, y]) => [+px(x).toFixed(4), +px(y).toFixed(4)]),
  length: lapLength,
  corners: corners.map((c) => [c.entry, c.exit]),
}) : null;

const arcs = marked ? corners.map((c) =>
  subPath(outline.points, c.entry / lapLength!, c.exit / lapLength!)
    .map(([x, y], i) => `${i === 0 ? 'M' : 'L'}${px(x).toFixed(4)} ${px(y).toFixed(4)}`)
    .join('')) : [];

// Start/finish: a chequered band squared to the local tangent.
//
// Every part of it is a filled polygon. This band is rotated to the track, so
// its edges cannot snap to the pixel grid and antialiasing is the correct
// result — but a stroke is centred on its boundary, so a sub-pixel one covers
// part of two pixels and reads as a smear rather than a line. Fills have no
// such problem: the frame is a larger polygon beneath the ground, and each
// square is its own quad.
const CHEQUER = showStart && height >= 240;
const CELL = 3.8, COLS = 9;
const startFrame = pointAndNormal(outline.points, 0, [cx, cy]);
const sN = startFrame.n;
const sT: [number, number] = [-sN[1], sN[0]];
const cell = unit(CELL);
const halfLen = (cell * COLS) / 2;
const sOx = px(startFrame.p[0]), sOy = px(startFrame.p[1]);
const cellQuad = (a0: number, a1: number, b0: number, b1: number) =>
  [[a0, b0], [a1, b0], [a1, b1], [a0, b1]]
    .map(([a, b]) => `${(sOx + sN[0] * a + sT[0] * b).toFixed(4)},${(sOy + sN[1] * a + sT[1] * b).toFixed(4)}`)
    .join(' ');

const chequerSquares: string[] = [];
if (CHEQUER) {
  for (let col = 0; col < COLS; col++) {
    for (let row = 0; row < 2; row++) {
      if ((col + row) % 2 !== 0) continue;       // the black half is the ground
      const a0 = -halfLen + col * cell;
      chequerSquares.push(cellQuad(a0, a0 + cell, (row - 1) * cell, row * cell));
    }
  }
}


// The dark squares are painted rather than left as holes: a solid black ground
// under the white dashes, so the chequer reads the same whatever it sits on.
// A hairline frame, offset by a little padding, lifts it off the tarmac.
// A stroke showed only half its width outside the edge, so as a fill this
// needs to be roughly halved to look the same.
const FRAME_PAD = 0.8;   // px
const quad = (alongHalf: number, acrossHalf: number) =>
  [[1, 1], [1, -1], [-1, -1], [-1, 1]]
    .map(([a, b]) => [
      sOx + sN[0] * a * alongHalf + sT[0] * b * acrossHalf,
      sOy + sN[1] * a * alongHalf + sT[1] * b * acrossHalf,
    ])
    .map(([x, y]) => `${x.toFixed(4)},${y.toFixed(4)}`)
    .join(' ');

const chequerGround = quad(halfLen, cell);
const chequerFrame = quad(halfLen + unit(FRAME_PAD), cell + unit(FRAME_PAD));
---
<svg
  class="outline"
  viewBox={`0 0 ${span} ${span}`}
  style={`height:${height}px`}
  role="img"
  data-track-map={linkData}
  aria-label={`Outline of ${name}${marked ? `, with ${corners.length} cornering sections highlighted in red` : ''}${showStart ? ', and a chequered line at start and finish' : ''}`}
>
  <path
    class="track" d={d} fill="none" stroke="currentColor"
    style={`stroke-width:${stroke}px`}
    stroke-linejoin="round" stroke-linecap="round"
    vector-effect="non-scaling-stroke"
  />

  {arcs.map((a, i) => (
    <path class="corner-arc" data-corner={i} d={a} fill="none"
          style={`stroke-width:${stroke * 2.6}px`}
          stroke-linecap="round" stroke-linejoin="round"
          vector-effect="non-scaling-stroke" />
  ))}

  {marked && (
    <circle class="hover-dot" r={unit(4.2)} cx="0" cy="0"
            style={`stroke-width:${stroke}px`} />
  )}

  {CHEQUER
    ? (
      <>
        <polygon class="chequer-frame" points={chequerFrame} />
        <polygon class="chequer-ground" points={chequerGround} />
        {chequerSquares.map((pts) => <polygon class="chequer" points={pts} />)}
      </>
    )
    : showStart && <circle cx={px(sx)} cy={px(sy)} r={unit(2.9)} fill="var(--ks-kinpaku)" />}
</svg>

<style>
  .outline { display: block; width: auto; max-width: 100%; overflow: visible; }
  .corner-arc { stroke: var(--f1-corner); transition: stroke var(--ks-quick) var(--ks-ease); }
  .corner-arc.is-active { stroke: var(--ks-kinpaku); }

  .hover-dot {
    fill: var(--ks-kinpaku); stroke: var(--ks-instrument);
    opacity: 0; pointer-events: none;
    vector-effect: non-scaling-stroke;
  }
  .outline.is-hovering .hover-dot { opacity: 1; }
  .chequer-frame { fill: #fff; }
  .chequer-ground { fill: #000; }
  .chequer { fill: #fff; }
</style>
