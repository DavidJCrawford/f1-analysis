---
import type { Outline, Corner } from '@lib/types';
import { pointAndNormal, subPath } from '@lib/geometry';

interface Props {
  outline: Outline; name: string;
  height?: number; stroke?: number; showStart?: boolean;
  corners?: Corner[]; lapLength?: number;
  /** Where the grid lines up, as a fraction of the lap from the finish line. */
  startFrac?: number | null;
}
const { outline, name, height = 120, stroke = 1.5, showStart = true,
        corners = [], lapLength, startFrac = null } = Astro.props;

const marked = corners.length > 0 && lapLength != null;
const PAD = 0.06;
/**
 * Outlines arrive fitted to a unit box, and drawing them in one is a mistake.
 * A circuit rendered at 440px out of a 1.12-unit viewBox is scaled 786 times,
 * which leaves the track's own stroke four thousandths of a user unit wide.
 * Everything the renderer derives in user space — above all the bounds it
 * invalidates when a sibling like the hover dot moves — is then computed on
 * numbers that small and multiplied back up by 786, and rounding that would be
 * invisible at 1:1 turns into missing pieces of the line. So the whole drawing
 * is done in a space where a unit is about a pixel.
 */
const S = 1000;
const span = (1 + PAD * 2) * S;
const px = (x: number) => (x + 0.5 + PAD) * S;
const unit = (v: number) => (v / height) * span;

const d = outline.points
  .map(([x, y], i) => `${i === 0 ? 'M' : 'L'}${px(x).toFixed(2)} ${px(y).toFixed(2)}`)
  .join('') + 'Z';
const [sx, sy] = outline.points[0]!;
const cx = outline.points.reduce((s, q) => s + q[0], 0) / outline.points.length;
const cy = outline.points.reduce((s, q) => s + q[1], 0) / outline.points.length;

/**
 * The stretch of track each corner occupies, drawn over the base line. These
 * are cornering sections derived from curvature — deliberately NOT numbered.
 * Official turn numbers are a convention assigned by the circuit and the FIA,
 * not a property of the shape: Monza's Variante Ascari is one complex numbered
 * as three turns. Numbering derived sections would assert something the
 * geometry cannot support.
 */
const linkData = marked ? JSON.stringify({
  pts: outline.points.map(([x, y]) => [+px(x).toFixed(2), +px(y).toFixed(2)]),
  length: lapLength,
  corners: corners.map((c) => [c.entry, c.exit]),
}) : null;

const arcs = marked ? corners.map((c) =>
  subPath(outline.points, c.entry / lapLength!, c.exit / lapLength!)
    .map(([x, y], i) => `${i === 0 ? 'M' : 'L'}${px(x).toFixed(2)} ${px(y).toFixed(2)}`)
    .join('')) : [];

// Start/finish: a chequered band squared to the local tangent.
//
// Every part of it is a filled polygon. This band is rotated to the track, so
// its edges cannot snap to the pixel grid and antialiasing is the correct
// result — but a stroke is centred on its boundary, so a sub-pixel one covers
// part of two pixels and reads as a smear rather than a line. Fills have no
// such problem: the frame is a larger polygon beneath the ground, and each
// square is its own quad.
const CHEQUER = showStart && height >= 240;
// A rotated edge cannot align to the pixel grid, so sharpness here comes from
// feature size rather than snapping: at 3.8px a cell was mostly antialiased
// edge. Larger cells, fewer of them, and a frame thick enough to cover a whole
// pixel instead of sitting as a grey seam between two blurred boundaries.
const CELL = 5.6, COLS = 7;
const FRAME_PAD = 1.4;   // px — a solid pixel, not a sub-pixel seam
const cell = unit(CELL);
const halfLen = (cell * COLS) / 2;

/** A band squared to the track at a fraction of the lap: where it sits, which
 *  way the track runs there, and quads measured out from it. */
function bandAt(frac: number) {
  const f = pointAndNormal(outline.points, frac, [cx, cy]);
  const N = f.n;                                 // across the track
  const T: [number, number] = [-N[1], N[0]];     // along it
  const ox = px(f.p[0]), oy = px(f.p[1]);
  const at = (a: number, b: number) =>
    `${(ox + N[0] * a + T[0] * b).toFixed(2)},${(oy + N[1] * a + T[1] * b).toFixed(2)}`;
  return {
    ox, oy, N, T,
    /** A rectangle: half its width across the track, half its depth along it. */
    quad: (acrossHalf: number, alongHalf: number) =>
      [[1, 1], [1, -1], [-1, -1], [-1, 1]].map(([a, b]) =>
        at(a * acrossHalf, b * alongHalf)).join(' '),
    cellQuad: (a0: number, a1: number, b0: number, b1: number) =>
      [at(a0, b0), at(a1, b0), at(a1, b1), at(a0, b1)].join(' '),
  };
}

const finishBand = bandAt(0);
const sOx = finishBand.ox, sOy = finishBand.oy, sN = finishBand.N;

const chequerSquares: string[] = [];
if (CHEQUER) {
  for (let col = 0; col < COLS; col++) {
    for (let row = 0; row < 2; row++) {
      if ((col + row) % 2 !== 0) continue;       // the black half is the ground
      const a0 = -halfLen + col * cell;
      chequerSquares.push(finishBand.cellQuad(a0, a0 + cell, (row - 1) * cell, row * cell));
    }
  }
}

/**
 * The other line. A Formula 1 circuit generally has two: the finish line, where
 * a lap is timed, and the start line at the front of the grid, and they are
 * rarely the same place — which is why a first lap is not a full lap. Drawn
 * only where we know it and where it is far enough away to be its own mark
 * rather than a thickening of the chequer.
 */
const gap = startFrac == null ? 0
  : Math.min(startFrac % 1, 1 - (startFrac % 1)) * (outline.length || 0);
const TWO_LINES = CHEQUER && startFrac != null && gap > 25;
const startBand = TWO_LINES ? bandAt(startFrac!) : null;
const startBar = startBand?.quad(halfLen, cell * 0.42) ?? null;
const startEdge = startBand?.quad(halfLen + unit(FRAME_PAD), cell * 0.42 + unit(FRAME_PAD)) ?? null;


// The dark squares are painted rather than left as holes: a solid black ground
// under the white dashes, so the chequer reads the same whatever it sits on.
// A hairline frame, offset by a little padding, lifts it off the tarmac.
const chequerGround = finishBand.quad(halfLen, cell);
const chequerFrame = finishBand.quad(halfLen + unit(FRAME_PAD), cell + unit(FRAME_PAD));
---
<svg
  class="outline"
  viewBox={`0 0 ${span} ${span}`}
  style={`height:${height}px`}
  role="img"
  data-track-map={linkData}
  aria-label={`Outline of ${name}${marked ? `, with ${corners.length} cornering sections highlighted in red` : ''}${showStart ? ', and a chequered line at start and finish' : ''}`}
>
  <path
    class="track" d={d} fill="none" stroke="currentColor"
    style={`stroke-width:${stroke}px`}
    stroke-linejoin="round" stroke-linecap="round"
    vector-effect="non-scaling-stroke"
  />

  {arcs.map((a, i) => (
    <path class="corner-arc" data-corner={i} d={a} fill="none"
          style={`stroke-width:${stroke * 2.6}px`}
          stroke-linecap="round" stroke-linejoin="round"
          vector-effect="non-scaling-stroke" />
  ))}

  {marked && (
    <circle class="hover-dot" r={unit(4.2)} cx="0" cy="0"
            style={`stroke-width:${stroke}px`} />
  )}

  {TWO_LINES && startBand && (
    <>
      <polygon class="chequer-ground" points={startEdge!} />
      <polygon class="start-bar" points={startBar!} />
      <text class="line-label" x={startBand.ox + startBand.N[0] * (halfLen + unit(9))}
            y={startBand.oy + startBand.N[1] * (halfLen + unit(9))}
            font-size={unit(8)} dominant-baseline="middle"
            text-anchor={startBand.N[0] < 0 ? 'end' : 'start'}>Start</text>
    </>
  )}

  {CHEQUER
    ? (
      <>
        <polygon class="chequer-frame" points={chequerFrame} />
        <polygon class="chequer-ground" points={chequerGround} />
        {chequerSquares.map((pts) => <polygon class="chequer" points={pts} />)}
        {TWO_LINES && (
          <text class="line-label" x={sOx + sN[0] * (halfLen + unit(9))}
                y={sOy + sN[1] * (halfLen + unit(9))}
                font-size={unit(8)} dominant-baseline="middle"
                text-anchor={sN[0] < 0 ? 'end' : 'start'}>Finish</text>
        )}
      </>
    )
    : showStart && <circle cx={px(sx)} cy={px(sy)} r={unit(2.9)} fill="var(--ks-kinpaku)" />}
</svg>

<style>
  .outline { display: block; width: auto; max-width: 100%; overflow: visible; }
  /* Only the map that can be pointed at, never the gallery: a finger dragged
     across this one is following the track, not scrolling the page. The
     attribute is absent on the small outlines, which must still scroll. */
  .outline[data-track-map] { touch-action: none; }
  .corner-arc { stroke: var(--f1-corner); transition: stroke var(--ks-quick) var(--ks-ease); }
  .corner-arc.is-active { stroke: var(--ks-kinpaku); }

  .hover-dot {
    fill: var(--ks-kinpaku); stroke: var(--ks-instrument);
    opacity: 0; pointer-events: none;
    vector-effect: non-scaling-stroke;
  }
  .outline.is-hovering .hover-dot { opacity: 1; }
  .chequer-frame { fill: #fff; }
  .chequer-ground { fill: #000; }
  .chequer { fill: #fff; }
  /* The start line is a plain painted bar; the chequer is the flag that ends a
     race. Telling them apart by their shape rather than by colour keeps both
     readable on a dark panel and needs no key. */
  .start-bar { fill: #fff; }
  .line-label {
    fill: var(--ks-instrument-muted);
    font-family: var(--ks-mono), monospace;
    text-transform: uppercase; letter-spacing: .14em;
  }
</style>
