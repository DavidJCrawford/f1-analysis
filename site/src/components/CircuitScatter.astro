---
import type { Circuit } from '@lib/types';

interface Props { field: Circuit[]; current: Circuit; season: number; }
const { field, current, season } = Astro.props;

const W = 1120, H = 500;
const M = { t: 30, r: 28, b: 52, l: 52 };
const PW = W - M.l - M.r, PH = H - M.t - M.b;

const has = (c: Circuit) => c.length != null && c.turns != null;
const onCalendar = field.some((c) => c.id === current.id);
// A circuit is always present on its own page, even when it last raced in 1955.
const pop = [...field.filter(has), ...(onCalendar || !has(current) ? [] : [current])];

// Domain fits the data. With a single season's field there is no long tail to
// clip, which is the point of narrowing the comparison to the current calendar.
const lens = pop.map((c) => c.length!), turns = pop.map((c) => c.turns!);
const xMin = Math.floor(Math.min(...lens) * 2) / 2 - 0.25;
const xMax = Math.ceil(Math.max(...lens) * 2) / 2 + 0.25;
const yMin = Math.max(0, Math.floor((Math.min(...turns) - 2) / 2) * 2);
const yMax = Math.ceil((Math.max(...turns) + 2) / 2) * 2;

const sx = (v: number) => M.l + ((v - xMin) / (xMax - xMin)) * PW;
const sy = (v: number) => M.t + PH - ((v - yMin) / (yMax - yMin)) * PH;

const med = (a: number[]) => { const s = [...a].sort((x, y) => x - y);
  return s.length % 2 ? s[(s.length - 1) / 2]! : (s[s.length / 2 - 1]! + s[s.length / 2]!) / 2; };
const medLen = med(lens), medTurns = med(turns);

const pts = pop.map((c) => ({ c, x: sx(c.length!), y: sy(c.turns!), self: c.id === current.id }));
const self = pts.find((p) => p.self);

// Anchor labels: the four extremes make the rest of the cloud readable. The
// current circuit is labelled first so it always wins a placement contest.
const by = (f: (c: Circuit) => number, dir: 1 | -1) =>
  [...pop].sort((a, b) => (f(a) - f(b)) * dir)[0];
const anchors = [by((c) => c.length!, -1), by((c) => c.length!, 1),
                 by((c) => c.turns!, -1), by((c) => c.turns!, 1)];
const wanted = [current, ...anchors].filter((c, i, a) =>
  has(c) && a.findIndex((q) => q.id === c.id) === i);

const placed: { x: number; y: number }[] = [];
const labels = wanted.map((c) => {
  const x = sx(c.length!), y = sy(c.turns!);
  for (const dy of [-17, 16]) {
    const ly = y + dy;
    if (ly < M.t + 4 || ly > M.t + PH) continue;
    if (placed.some((q) => Math.abs(q.x - x) < 62 && Math.abs(q.y - ly) < 13)) continue;
    placed.push({ x, y: ly });
    return { name: c.name, x, y: ly, self: c.id === current.id };
  }
  return null;
}).filter((l): l is NonNullable<typeof l> => l !== null);

const xTicks: number[] = [];
for (let v = Math.ceil(xMin); v <= xMax; v += 1) xTicks.push(v);
const yTicks: number[] = [];
for (let v = yMin; v <= yMax; v += (yMax - yMin > 16 ? 4 : 2)) yTicks.push(v);

const density = current.turns! / current.length!;
const medDensity = medTurns / medLen;
---
<figure class="scatter" role="group">
  <figcaption class="eyebrow">
    {season} calendar · {field.filter(has).length} circuits
    {!onCalendar && <> · {current.name} shown for scale</>}
  </figcaption>

  <svg viewBox={`0 0 ${W} ${H}`} class="chart" role="img"
       aria-label={`Circuit length against turn count for the ${field.filter(has).length} circuits on the ${season} calendar. ${current.name} has ${current.turns} turns over ${current.length?.toFixed(3)} kilometres, against a median of ${medTurns} turns over ${medLen.toFixed(3)} kilometres.`}>

    {yTicks.map((v) => (
      <>
        <line class="grid" x1={M.l} y1={sy(v)} x2={W - M.r} y2={sy(v)} />
        <text class="tick" x={M.l - 10} y={sy(v) + 4} text-anchor="end">{v}</text>
      </>
    ))}
    {xTicks.map((v) => (
      <>
        <line class="grid" x1={sx(v)} y1={M.t} x2={sx(v)} y2={M.t + PH} />
        <text class="tick" x={sx(v)} y={M.t + PH + 20} text-anchor="middle">{v} km</text>
      </>
    ))}

    <line class="median" x1={sx(medLen)} y1={M.t} x2={sx(medLen)} y2={M.t + PH} />
    <line class="median" x1={M.l} y1={sy(medTurns)} x2={W - M.r} y2={sy(medTurns)} />
    <text class="medlabel" x={sx(medLen) + 6} y={M.t - 8}>median length</text>
    <text class="medlabel" x={W - M.r} y={sy(medTurns) - 7} text-anchor="end">median turns</text>

    {pts.filter((p) => !p.self).map((p) => <circle class="dot" cx={p.x} cy={p.y} r="5" />)}

    {self && (
      <>
        <circle class="halo" cx={self.x} cy={self.y} r="12" />
        <circle class="self" cx={self.x} cy={self.y} r="6" />
      </>
    )}

    {labels.map((l) => (
      <text class={l.self ? 'lab self-lab' : 'lab'} x={l.x} y={l.y} text-anchor="middle">{l.name}</text>
    ))}

    <text class="axis-title" x={M.l + PW / 2} y={H - 6} text-anchor="middle">circuit length</text>
    <text class="axis-title" x={-(M.t + PH / 2)} y="13" text-anchor="middle"
          transform="rotate(-90)">turns</text>
  </svg>

  <p class="ui muted note">
    {current.turns} turns over <span class="num">{current.length!.toFixed(3)}</span> km —
    <strong class="num"> {density.toFixed(1)}</strong> turns per kilometre, against a median of
    <strong class="num"> {medDensity.toFixed(1)}</strong> across the {season} calendar.
  </p>
</figure>

<style>
  .scatter { margin: 0; }
  .chart { display: block; width: 100%; height: auto; }

  .grid   { stroke: var(--ks-rule); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .median { stroke: var(--ks-edge); stroke-width: 1; stroke-dasharray: 2 4; vector-effect: non-scaling-stroke; }

  .dot  { fill: var(--ks-ink); fill-opacity: .32; }
  .halo { fill: var(--ks-kinpaku); fill-opacity: .22; }
  .self { fill: var(--ks-kinpaku-deep); }

  .tick, .medlabel, .axis-title { font-family: var(--ks-mono), monospace; fill: var(--ks-text-muted); }
  .tick       { font-size: 11px; font-variant-numeric: var(--f1-numeric); }
  .medlabel   { font-size: 9.5px; letter-spacing: .1em; text-transform: uppercase; fill: var(--ks-text-mute-deep); }
  .axis-title { font-size: 10px; letter-spacing: .14em; text-transform: uppercase; }

  .lab      { font-size: 11.5px; fill: var(--ks-text-muted); font-family: var(--ks-font), sans-serif; }
  .self-lab { fill: var(--ks-ink); font-weight: 600; }

  .note { margin-top: 14px; }
  .note strong { font-weight: 600; color: var(--ks-ink); }
</style>
