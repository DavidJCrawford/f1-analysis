---
interface Props { manifest: Record<string, unknown>; base: string; label: string; }
const { manifest, base, label } = Astro.props;

/** Rendered server-side, not built in script: Astro scopes component CSS with a
 *  data-astro-cid attribute, and elements created via createElement never get
 *  it — so every rule below would silently miss them. */
const drivers = (manifest.drivers ?? []) as
  { n: number; code: string; name: string; team: string; colour: string }[];
---
<div class="replay-launch">
  <button class="play" type="button" data-replay-open aria-haspopup="dialog">
    <svg viewBox="0 0 24 24" aria-hidden="true" width="15" height="15"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>
    <span>Replay the race</span>
  </button>
  <span class="ui muted hint">Full race from the timing feed</span>
</div>

<div class="replay" data-replay hidden
     data-manifest={JSON.stringify(manifest)} data-bin={base}
     role="dialog" aria-modal="true" aria-label={`Race replay — ${label}`}>
  <header class="bar top">
    <div class="id">
      <span class="mono">Replay</span>
      <span class="title">{label}</span>
    </div>
    <div class="readout mono num" data-readout>—</div>
    <button class="icon" type="button" data-replay-close aria-label="Close replay">✕</button>
  </header>

  <div class="stage">
    <canvas data-canvas></canvas>
    <p class="loading mono" data-loading>Loading positions…</p>
    <p class="countdown num" data-countdown hidden aria-live="assertive"></p>
    <div class="zoom">
      <button class="icon sm" type="button" data-zoom="-1" aria-label="Zoom out">−</button>
      <button class="icon sm" type="button" data-zoom="1" aria-label="Zoom in">+</button>
    </div>
  </div>

  <div class="bar controls">
    <button class="icon" type="button" data-act="restart" aria-label="Restart">⏮</button>
    <button class="icon" type="button" data-act="back" aria-label="Rewind">◀◀</button>
    <button class="icon wide" type="button" data-act="play" aria-label="Play">▶</button>
    <label class="speed">
      <span class="visually-hidden">Speed</span>
      <select data-speed>
        <option value="10" selected>10×</option>
        <option value="30">30×</option>
        <option value="60">60×</option>
        <option value="120">120×</option>
      </select>
    </label>
    <input class="scrub" type="range" min="0" max="1000" value="0" step="1"
           data-scrub aria-label="Race position" />
  </div>

  <ol class="strip" data-strip aria-label="Running order">
    {drivers.map((d, i) => (
      <li>
        <button type="button" data-car={i} aria-pressed="false"
                style={`border-color:${d.colour}`} title={`${d.name} — ${d.team}`}>
          <span class="pos"></span>
          <span class="car">{d.n}</span>
          <span class="code">{d.code}</span>
          <span class="down"></span>
        </button>
      </li>
    ))}
  </ol>
</div>

<style>
  .replay-launch { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin: 2rem 0 0; }
  .play {
    display: inline-flex; align-items: center; gap: 9px;
    background: var(--ks-ink); color: var(--ks-paper);
    border: 0; border-radius: var(--ks-radius-pill);
    padding: 10px 20px 10px 16px; cursor: pointer;
    font: inherit; font-size: var(--ks-type-ui-size); letter-spacing: .04em;
    transition: background var(--ks-quick) var(--ks-ease), transform var(--ks-quick) var(--ks-ease);
  }
  .play:hover { background: var(--ks-instrument-raised); transform: translateY(-1px); }
  .play:focus-visible { outline: 2px solid var(--ks-patina-deep); outline-offset: 3px; }
  .hint { white-space: nowrap; }

  .replay {
    position: fixed; inset: 0; z-index: 50;
    background: var(--ks-instrument-deep); color: var(--ks-instrument-text);
    display: grid; grid-template-rows: auto 1fr auto auto;
    color-scheme: dark;
  }
  .replay[hidden] { display: none; }

  .bar { display: flex; align-items: center; gap: 16px; padding: 12px clamp(14px, 3vw, 28px); }
  .top { border-bottom: 1px solid var(--ks-instrument-rule); }
  .id { display: flex; align-items: baseline; gap: 12px; min-width: 0; }
  .id .mono { color: var(--ks-instrument-muted); letter-spacing: .14em; }
  .id .title { font-weight: 600; font-size: var(--ks-type-title-size); color: var(--ks-instrument-text); }
  .readout { margin-left: auto; color: var(--ks-instrument-muted); letter-spacing: .06em; text-transform: none; }

  .icon {
    background: transparent; color: var(--ks-instrument-text);
    border: 1px solid var(--ks-instrument-rule); border-radius: var(--ks-radius-sm);
    min-width: 34px; height: 30px; cursor: pointer; font: inherit; font-size: 12px;
    transition: border-color var(--ks-quick) var(--ks-ease), background var(--ks-quick) var(--ks-ease);
  }
  .icon:hover { border-color: var(--ks-instrument-edge); background: var(--ks-instrument); }
  .icon:focus-visible { outline: 2px solid var(--ks-patina); outline-offset: 2px; }
  .icon.wide { min-width: 46px; }
  .icon.sm { min-width: 26px; height: 26px; }

  .stage { position: relative; overflow: hidden; background: var(--ks-instrument); }
  .stage canvas { display: block; width: 100%; height: 100%; }
  .loading {
    position: absolute; inset: 0; display: grid; place-items: center;
    color: var(--ks-instrument-muted); letter-spacing: .14em; margin: 0;
    pointer-events: none;
  }
  .loading[hidden] { display: none; }
  .zoom { position: absolute; right: 14px; bottom: 14px; display: flex; flex-direction: column; gap: 6px; }

  .countdown {
    position: absolute; inset: 0; display: grid; place-items: center;
    margin: 0; pointer-events: none;
    font-family: var(--ks-font-display), sans-serif;
    font-size: clamp(5rem, 18vw, 12rem); font-weight: 200; line-height: 1;
    color: var(--ks-instrument-text);
    text-shadow: 0 2px 40px rgba(0, 0, 0, .6);
  }
  .countdown[hidden] { display: none; }

  .controls { border-top: 1px solid var(--ks-instrument-rule); }
  .speed select {
    background: transparent; color: var(--ks-instrument-text);
    border: 1px solid var(--ks-instrument-rule); border-radius: var(--ks-radius-sm);
    padding: 6px 8px; font: inherit; font-size: var(--ks-type-ui-size);
  }
  .scrub { flex: 1; accent-color: var(--ks-kinpaku); min-width: 120px; }

  .strip {
    display: flex; gap: 6px; list-style: none; margin: 0;
    padding: 12px clamp(14px, 3vw, 28px) 16px;
    overflow-x: auto; border-top: 1px solid var(--ks-instrument-rule);
    scrollbar-width: thin;
  }
  .strip li { flex: 0 0 auto; }
  /* The team colour is the box edge. Behind the text it fought the numerals;
     as a border it identifies the car without competing with them. */
  .strip button {
    display: flex; align-items: center; gap: 8px;
    background: var(--ks-instrument-deep);
    border: 2.5px solid transparent; border-radius: 5px;
    padding: 5px 10px 5px 7px;
    cursor: pointer; font: inherit; color: var(--ks-instrument-text);
    transition: background var(--ks-quick) var(--ks-ease), transform var(--ks-quick) var(--ks-ease);
  }
  .strip button:hover { background: var(--ks-instrument); transform: translateY(-1px); }
  .strip button:focus-visible { outline: 2px solid var(--ks-patina); outline-offset: 2px; }
  .strip button[aria-pressed='true'] {
    background: var(--ks-instrument-raised);
    box-shadow: 0 0 0 1.5px var(--ks-kinpaku);
  }
  .strip .pos {
    font-family: var(--ks-mono), monospace; font-size: 10px;
    color: var(--ks-instrument-muted); min-width: 14px; text-align: right;
    font-variant-numeric: var(--f1-numeric);
    padding-right: 7px; border-right: 1px solid var(--ks-instrument-rule);
  }
  .strip .car {
    font-size: 12px; font-weight: 700;
    font-variant-numeric: var(--f1-numeric);
    min-width: 17px; text-align: right;
  }
  .strip .code { font-size: 11px; letter-spacing: .07em; color: var(--ks-instrument-muted); }
  .strip .down { font-size: 9.5px; color: var(--ks-instrument-muted); font-family: var(--ks-mono), monospace; }
  /* Out of the race: the row fades and the label says why, so the strip reads
     as the running order with two cars set aside rather than a list of equals. */
  .strip button[data-state='pit'],
  .strip button[data-state='out'] { opacity: .55; }
  .strip button[data-state='pit'] .down { color: var(--ks-kinpaku); letter-spacing: .08em; }
  .strip button[data-state='out'] .down { color: var(--ks-instrument-text); letter-spacing: .08em; }

  @media (prefers-reduced-motion: reduce) {
    .play:hover, .strip button:hover { transform: none; }
  }
</style>

<script>
  type Driver = { n: number; code: string; name: string; team: string; colour: string };
  type Manifest = {
    frames: number; cars: number; step: number; scale: number;
    posOffset: number; lapOffset: number; leadOffset: number;
    drivers: Driver[]; track: number[][];
    spans?: number[][];
    start?: { x: number; y: number; tx: number; ty: number; frac?: number } | null;
  };

  const root = document.querySelector<HTMLElement>('[data-replay]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-replay-open]');
  if (root && openBtn) {
    const man: Manifest = JSON.parse(root.dataset.manifest!);
    const binUrl = root.dataset.bin!;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const ctx = canvas.getContext('2d')!;
    const strip = root.querySelector<HTMLOListElement>('[data-strip]')!;
    const scrub = root.querySelector<HTMLInputElement>('[data-scrub]')!;
    const speedSel = root.querySelector<HTMLSelectElement>('[data-speed]')!;
    const readout = root.querySelector<HTMLElement>('[data-readout]')!;
    const loading = root.querySelector<HTMLElement>('[data-loading]')!;
    const countdown = root.querySelector<HTMLElement>('[data-countdown]')!;
    const playBtn = root.querySelector<HTMLButtonElement>('[data-act="play"]')!;

    const N = man.cars;
    let xy: Int16Array | null = null;
    let pos: Uint8Array | null = null;
    let down: Uint8Array | null = null;     // laps behind the leader, per car
    let lead: Uint8Array | null = null;     // the lap the race is on

    let frame = 0, playing = false, dir = 1, zoom = 4.5, focus = -1;
    // The camera eases toward whoever it is following rather than being pinned
    // to them, so a change of leader glides instead of cutting.
    let camX = 0, camY = 0, camTX = 0, camTY = 0, camReady = false;
    let raf = 0, last = 0, opener: HTMLElement | null = null;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ── data ────────────────────────────────────────────────────────────────
    async function load() {
      if (xy) return;
      const buf = await (await fetch(binUrl)).arrayBuffer();
      xy = new Int16Array(buf, 0, man.frames * N * 2);
      pos = new Uint8Array(buf, man.posOffset, man.frames * N);
      down = new Uint8Array(buf, man.lapOffset, man.frames * N);
      lead = new Uint8Array(buf, man.leadOffset, man.frames);
      loading.hidden = true;
      buildStrip();
    }

    const ABSENT = -32768;
    /** Car position at a fractional frame, interpolated between samples. */
    function carAt(f: number, car: number): [number, number] | null {
      if (!xy) return null;
      const a = Math.min(man.frames - 1, Math.floor(f));
      const b = Math.min(man.frames - 1, a + 1);
      const u = f - a;
      const ia = (a * N + car) * 2, ib = (b * N + car) * 2;
      const xa = xy[ia], ya = xy[ia + 1], xb = xy[ib], yb = xy[ib + 1];
      if (xa === ABSENT || ya === ABSENT) return null;
      if (xb === ABSENT || yb === ABSENT) return [xa, ya];
      return [xa + (xb - xa) * u, ya + (yb - ya) * u];
    }

    const orderAt = (f: number) => {
      const i = Math.min(man.frames - 1, Math.max(0, Math.round(f)));
      return pos ? Array.from(pos.subarray(i * N, i * N + N)) : [];
    };
    const frameAt = (f: number) => Math.min(man.frames - 1, Math.max(0, Math.round(f)));
    /** How many laps behind the leader, measured in distance round the circuit
     *  rather than by lap number: mid-race most of the field reads a lap lower
     *  on the counter simply for not having reached the line yet. */
    const downOf = (f: number, car: number) => (down ? down[frameAt(f) * N + car] : 0);
    const lapOf = (f: number) => (lead ? lead[frameAt(f)] : 0);

    // ── strip ───────────────────────────────────────────────────────────────
    const chips = [...strip.querySelectorAll<HTMLButtonElement>('button[data-car]')];
    function buildStrip() {
      chips.forEach((b, i) =>
        b.addEventListener('click', () => { focus = focus === i ? -1 : i; paint(); }));
    }

    // What each car is doing, as spans rather than a value per frame: a car is
    // racing almost all the time, so this is a handful of entries each.
    const RACING = 0, PIT = 1, STOPPED = 2;
    const spans: number[][][] = man.drivers.map(() => []);
    for (const [car, a, b, kind] of (man.spans ?? []) as number[][]) {
      if (spans[car]) spans[car].push([a, b, kind]);
    }
    function stateAt(f: number, car: number) {
      for (const [a, b, kind] of spans[car] ?? []) if (f >= a && f <= b) return kind;
      return RACING;
    }

    let stripKey = '';
    function updateStrip(f: number) {
      const ord = orderAt(f);
      if (!ord.length) return;
      // Only touch the strip when something in it actually changed. Rewriting
      // and reordering twenty-two rows of a scrolling flex list on every
      // animation frame is what made the field shimmer the moment the cars
      // moved; reading the laps to compare is a few typed-array lookups.
      const laps = ord.map((car) => downOf(f, car));
      const states = ord.map((car) => stateAt(f, car));
      const key = `${focus}|${ord.join(',')}|${laps.join(',')}|${states.join(',')}`;
      if (key === stripKey) return;
      stripKey = key;

      const held = document.activeElement;
      const frag = document.createDocumentFragment();
      ord.forEach((car, p) => {
        const b = chips[car];
        if (!b) return;
        b.querySelector('.pos')!.textContent = String(p + 1);
        b.querySelector('.down')!.textContent =
          states[p] === PIT ? 'PIT'
          : states[p] === STOPPED ? 'OUT'
          : laps[p] > 0 ? `+${laps[p]}L` : '';
        b.dataset.state = states[p] === PIT ? 'pit' : states[p] === STOPPED ? 'out' : '';
        b.setAttribute('aria-pressed', String(focus === car));
        frag.appendChild(b.parentElement!);
      });
      // Every row is in the fragment, so one append puts the whole list back in
      // order in a single layout pass without rebuilding any of the buttons.
      strip.appendChild(frag);
      if (held instanceof HTMLElement && held.isConnected) held.focus({ preventScroll: true });
    }

    // ── drawing ─────────────────────────────────────────────────────────────
    function resize() {
      const r = canvas.getBoundingClientRect();
      const dpr = Math.min(2, devicePixelRatio || 1);
      canvas.width = Math.max(1, Math.round(r.width * dpr));
      canvas.height = Math.max(1, Math.round(r.height * dpr));
    }

    /**
     * The chequer, laid across the track at the line. Index 0 of the polyline
     * is the start/finish line — a lap begins where the car crosses it — so the
     * marker goes there, squared to the local tangent. Sizes divide by `unit`
     * so the band stays a constant size on screen as the camera zooms.
     */
    /**
     * The two lines. A Formula 1 circuit generally has both: the finish line,
     * where a lap is timed, and the start line at the front of the grid, and
     * they are rarely the same place — which is why a first lap is not a full
     * lap. The chequer is the finish, because the chequer is the flag that ends
     * a race; the start is a plain painted bar, the way it is on the tarmac.
     * Shapes rather than colours, so neither needs a key to read.
     */
    function drawBand(
      x0: number, y0: number, tx: number, ty: number,
      unit: number, dpr: number, kind: 'finish' | 'start',
    ) {
      const nx = -ty, ny = tx;                    // across the track
      const cell = 5 * dpr / unit;
      const COLS = 6;
      const half = (cell * COLS) / 2;
      const depth = kind === 'finish' ? cell : cell * 0.42;

      const quad = (a0: number, a1: number, b0: number, b1: number) => {
        ctx.beginPath();
        ctx.moveTo(x0 + nx * a0 + tx * b0, y0 + ny * a0 + ty * b0);
        ctx.lineTo(x0 + nx * a1 + tx * b0, y0 + ny * a1 + ty * b0);
        ctx.lineTo(x0 + nx * a1 + tx * b1, y0 + ny * a1 + ty * b1);
        ctx.lineTo(x0 + nx * a0 + tx * b1, y0 + ny * a0 + ty * b1);
        ctx.closePath();
        ctx.fill();
      };

      const pad = cell * 0.28;
      ctx.fillStyle = '#000';
      quad(-half - pad, half + pad, -depth - pad, depth + pad);
      if (kind === 'start') {
        ctx.fillStyle = '#fff';
        quad(-half, half, -depth, depth);
      } else {
        ctx.fillStyle = '#fff';
        quad(-half - pad, half + pad, -depth - pad, depth + pad);
        ctx.fillStyle = '#000';
        quad(-half, half, -depth, depth);
        ctx.fillStyle = '#fff';
        for (let c = 0; c < COLS; c++) {
          for (let r = 0; r < 2; r++) {
            if ((c + r) % 2 !== 0) continue;
            const a0 = -half + c * cell;
            quad(a0, a0 + cell, (r - 1) * cell, r * cell);
          }
        }
      }

      // Named only when both are drawn, because only then is there a question.
      if (!twoLines()) return;
      ctx.save();
      ctx.translate(x0 + nx * (half + cell * 1.5), y0 + ny * (half + cell * 1.5));
      ctx.scale(1 / unit, -1 / unit);
      ctx.fillStyle = 'rgba(255,255,255,.5)';
      ctx.font = `500 ${8 * dpr}px ui-monospace, monospace`;
      ctx.textAlign = nx < 0 ? 'right' : 'left';
      ctx.textBaseline = 'middle';
      ctx.fillText(kind === 'finish' ? 'FINISH' : 'START', 0, 0);
      ctx.restore();
    }

    /** Metres round the lap, for judging whether the two lines are apart. */
    let lapMetres = 0;
    function trackLength() {
      if (lapMetres || !man.track) return lapMetres;
      let d = 0;
      for (let i = 0; i < man.track.length; i++) {
        const a = man.track[i], b = man.track[(i + 1) % man.track.length];
        d += Math.hypot(b[0] - a[0], b[1] - a[1]);
      }
      return (lapMetres = d / man.scale);
    }

    function drawLines(unit: number, dpr: number) {
      const tr = man.track;
      if (!tr || tr.length < 6) return;
      const a = tr[3], b = tr[tr.length - 3];
      let tx = a[0] - b[0], ty = a[1] - b[1];
      const tl = Math.hypot(tx, ty) || 1;
      drawBand(tr[0][0], tr[0][1], tx / tl, ty / tl, unit, dpr, 'finish');
      if (twoLines()) {
        const st = man.start!;
        drawBand(st.x, st.y, st.tx, st.ty, unit, dpr, 'start');
      }
    }

    /** Some circuits paint one line and start and finish on it, and several
     *  more are closer together than we can measure — see CircuitOutline. */
    function twoLines() {
      const st = man.start;
      if (!st || st.frac == null) return false;
      const f = ((st.frac % 1) + 1) % 1;
      return Math.min(f, 1 - f) * trackLength() > 50;
    }

    function paint() {
      if (!xy) return;
      const w = canvas.width, h = canvas.height;
      const dpr = Math.min(2, devicePixelRatio || 1);
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, w, h);

      const ord = orderAt(frame);
      const lead = focus >= 0 ? focus : (ord[0] ?? 0);
      const target = carAt(frame, lead);
      if (target) { camTX = target[0]; camTY = target[1]; }
      if (!camReady) { camX = camTX; camY = camTY; camReady = true; }
      else {
        const k = reduced ? 1 : 0.16;
        camX += (camTX - camX) * k;
        camY += (camTY - camY) * k;
      }
      const unit = (Math.min(w, h) / 34000) * zoom;

      ctx.translate(w / 2, h / 2);
      ctx.scale(unit, -unit);                       // y up
      ctx.translate(-camX, -camY);

      if (man.track?.length) {
        ctx.beginPath();
        man.track.forEach(([x, y], i) => (i ? ctx.lineTo(x, y) : ctx.moveTo(x, y)));
        ctx.closePath();
        ctx.lineWidth = 26 / unit * dpr * 0.5;
        ctx.strokeStyle = 'rgba(255,255,255,.13)';
        ctx.lineJoin = 'round';
        ctx.stroke();
        ctx.lineWidth = 2 / unit;
        ctx.strokeStyle = 'rgba(255,255,255,.32)';
        ctx.stroke();
        drawLines(unit, dpr);
      }

      // Back of the field first, so leaders sit on top.
      for (let p = ord.length - 1; p >= 0; p--) {
        const car = ord[p];
        const c = carAt(frame, car);
        if (!c) continue;
        const d = man.drivers[car];
        const st = stateAt(frame, car);
        const r = (car === lead ? 13 : 11) * dpr / unit;
        // A car out of the race reads as an outline rather than a disc: it is
        // still where the timing feed puts it, but it is no longer racing, and
        // a hollow marker says so without needing a key to read it.
        ctx.globalAlpha = st === RACING ? 1 : 0.55;
        ctx.beginPath();
        ctx.arc(c[0], c[1], r, 0, Math.PI * 2);
        if (st === RACING) {
          ctx.fillStyle = d.colour;
          ctx.fill();
        } else {
          ctx.fillStyle = 'rgba(12,12,12,.92)';
          ctx.fill();
          ctx.lineWidth = 2.5 * dpr / unit;
          ctx.strokeStyle = d.colour;
          ctx.stroke();
        }
        if (car === lead) {
          ctx.lineWidth = 2.5 * dpr / unit;
          ctx.strokeStyle = '#fff';
          ctx.stroke();
        }
        ctx.save();
        ctx.translate(c[0], c[1]);
        ctx.scale(1 / unit, -1 / unit);
        ctx.fillStyle = st === RACING ? '#fff' : d.colour;
        ctx.font = `700 ${10 * dpr}px ui-monospace, monospace`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.shadowColor = 'rgba(0,0,0,.6)';
        ctx.shadowBlur = 3 * dpr;
        ctx.fillText(String(d.n), 0, 0.5 * dpr);
        ctx.restore();
        ctx.globalAlpha = 1;
      }

      ctx.setTransform(1, 0, 0, 1, 0, 0);
      updateStrip(frame);
      const t = frame * man.step;
      const mm = String(Math.floor(t / 60)).padStart(2, '0');
      const ss = String(Math.floor(t % 60)).padStart(2, '0');
      readout.textContent = `Lap ${lapOf(frame)} · ${mm}:${ss}`;
      scrub.value = String(Math.round((frame / (man.frames - 1)) * 1000));
    }

    // ── playback ────────────────────────────────────────────────────────────
    function tick(now: number) {
      if (playing) {
        const dt = Math.min(0.25, (now - last) / 1000);
        frame += (dt * Number(speedSel.value) / man.step) * dir;
        if (frame >= man.frames - 1) { frame = man.frames - 1; setPlaying(false); }
        if (frame <= 0) { frame = 0; setPlaying(false); }
        paint();
      } else if (camReady && Math.hypot(camTX - camX, camTY - camY) > 2) {
        paint();                       // let the camera finish settling
      }
      last = now;
      raf = requestAnimationFrame(tick);
    }

    function setPlaying(v: boolean) {
      // Restart the clock on the transition into play. The loop keeps it fresh
      // while it runs, but requestAnimationFrame stops in a hidden tab, so
      // without this the first frame back could carry a long idle stretch.
      if (v && !playing) last = performance.now();
      playing = v;
      playBtn.textContent = v ? '❚❚' : '▶';
      playBtn.setAttribute('aria-label', v ? 'Pause' : 'Play');
    }

    root.querySelector('[data-act="restart"]')!.addEventListener('click', () => {
      stopCountdown(); frame = 0; dir = 1; paint();
    });
    root.querySelector('[data-act="back"]')!.addEventListener('click', () => {
      stopCountdown(); dir = -1; setPlaying(true);
    });
    playBtn.addEventListener('click', () => { stopCountdown(); dir = 1; setPlaying(!playing); });
    scrub.addEventListener('input', () => {
      stopCountdown();
      frame = (Number(scrub.value) / 1000) * (man.frames - 1);
      setPlaying(false); paint();
    });
    root.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((b) =>
      b.addEventListener('click', () => {
        zoom = Math.max(1, Math.min(14, zoom * (Number(b.dataset.zoom) > 0 ? 1.35 : 1 / 1.35)));
        paint();
      }));

    // ── countdown ───────────────────────────────────────────────────────────
    // Only before the opening lap, and any interaction cancels it — a count
    // that ran again on every resume would be an obstacle rather than a cue.
    let countToken = 0;
    function stopCountdown() { countToken++; countdown.hidden = true; }

    async function runCountdown(from = 5) {
      const token = ++countToken;
      for (let i = from; i > 0; i--) {
        if (token !== countToken || root!.hidden) return false;
        countdown.textContent = String(i);
        countdown.hidden = false;
        await new Promise((r) => setTimeout(r, 1000));
      }
      if (token !== countToken || root!.hidden) return false;
      countdown.hidden = true;
      return true;
    }

    // ── open / close ────────────────────────────────────────────────────────
    async function open() {
      opener = document.activeElement as HTMLElement;
      root!.hidden = false;
      document.body.style.overflow = 'hidden';
      resize();
      await load();
      frame = 0; zoom = 4.5; focus = -1; camReady = false; stripKey = '';
      paint();
      playBtn.focus();
      if (!reduced && await runCountdown()) { dir = 1; setPlaying(true); }
    }
    function close() {
      stopCountdown();
      setPlaying(false);
      root!.hidden = true;
      document.body.style.overflow = '';
      opener?.focus();
    }

    openBtn.addEventListener('click', open);
    root.querySelector('[data-replay-close]')!.addEventListener('click', close);
    addEventListener('keydown', (e) => {
      if (root!.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === ' ') { e.preventDefault(); stopCountdown(); dir = 1; setPlaying(!playing); }
      if (e.key === 'ArrowLeft') { setPlaying(false); frame = Math.max(0, frame - 20); paint(); }
      if (e.key === 'ArrowRight') { setPlaying(false); frame = Math.min(man.frames - 1, frame + 20); paint(); }
    });
    addEventListener('resize', () => { if (!root!.hidden) { resize(); paint(); } });
    raf = requestAnimationFrame(tick);
    void raf;
  }
</script>
