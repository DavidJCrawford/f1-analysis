---
interface Props { label: string; value: string | number; }
const { label, value } = Astro.props;
---
<div class="stat">
  <div class="eyebrow">{label}</div>
  <div class="value num">{value}</div>
</div>

<style>
  .stat .value {
    font-size: var(--ks-type-title-lg-size);
    font-weight: 300;
    color: var(--ks-ink);
    line-height: 1.2;
    margin-top: 2px;
  }
</style>
