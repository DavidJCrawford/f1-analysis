---
import type { Profile } from '@lib/types';

interface Props { profile: Profile; name: string; }
const { profile: p, name } = Astro.props;

const W = 1000, H = 190, CY = 96, AMP = 66, PADX = 14;

// Deflection is sqrt-scaled: a hairpin and a fast kink differ by ~30x in
// curvature, and a linear scale renders everything but the hairpins flat.
const kappa = p.k;
const kMax = Math.max(...kappa.map(Math.abs), 1e-6);
const n = kappa.length;
const xAt = (i: number) => PADX + (i / (n - 1)) * (W - PADX * 2);
const yAt = (k: number) => CY - Math.sign(k) * Math.sqrt(Math.abs(k) / kMax) * AMP;

// Both ends of the axis are the start/finish line, so both carry the chequer.
// Two dashed strokes offset by half a period, as on the circuit map, over a
// black ground so the dark squares are painted rather than left as holes.
const SF_CELL = 8;
const SF_TOP = CY - AMP - 6;
const SF_ROWS = Math.round(((CY + AMP + 6) - SF_TOP) / SF_CELL);
const SF_H = SF_ROWS * SF_CELL;
const sfBars = [PADX, W - PADX];

const ribbon =
  `M${xAt(0).toFixed(1)} ${CY}` +
  kappa.map((k, i) => `L${xAt(i).toFixed(1)} ${yAt(k).toFixed(1)}`).join('') +
  `L${xAt(n - 1).toFixed(1)} ${CY}Z`;

// Position along the lap -> x. The profile is sampled at uniform arc length.
const xOfDist = (d: number) => PADX + (d / p.length) * (W - PADX * 2);

// Straights: the gaps between detected corners, wrapping the start/finish line.
const cs = p.corners;
const lefts = cs.filter((c) => c.dir === 'L').length;

const straights = cs.map((c, i) => {
  const next = cs[(i + 1) % cs.length]!;
  const from = c.exit;
  const to = i === cs.length - 1 ? next.entry + p.length : next.entry;
  return { from, to, len: to - from };
}).filter((s) => s.len > 250).sort((a, b) => b.len - a.len);
const longest = straights[0];

// A straight that runs through the start/finish line sits at both ends of the
// axis. Drawn as one rect it was clipped at the right edge and the far half
// never appeared, so split it into the two pieces it actually occupies.
const wraps = !!longest && longest.to > p.length;
const segments: [number, number][] = !longest
  ? []
  : wraps
    ? [[longest.from, p.length], [0, longest.to - p.length]]
    : [[longest.from, longest.to]];

// Label the piece that begins the lap: it has the whole axis to its right,
// where the tail piece had nothing but the edge. Clamped either way, since the
// caption is about 200 units wide and text-anchor is middle.
const labelSeg = wraps ? segments[1]! : segments[0];
const HALF_LABEL = 105;
const labelX = labelSeg
  ? Math.max(PADX + HALF_LABEL,
      Math.min(W - PADX - HALF_LABEL, (xOfDist(labelSeg[0]) + xOfDist(labelSeg[1])) / 2))
  : 0;


---
<figure class="profile" role="group">
  <figcaption class="eyebrow">
    The lap unrolled · left turns deflect up, right turns down · flat is straight
  </figcaption>

  <svg viewBox={`0 0 ${W} ${H}`} class="chart"
       data-track-profile={JSON.stringify({ w: W, padx: PADX, length: p.length, cy: CY, amp: AMP })}
       role="img"
       aria-label={`Curvature profile of ${name}. ${cs.length} detected corners, ${lefts} left and ${cs.length - lefts} right, around a ${(p.length / 1000).toFixed(3)} kilometre lap.`}>
    {segments.map(([a, b]) => (
      <rect class="straight" x={xOfDist(a)} y={CY - AMP - 10}
            width={Math.max(0, xOfDist(b) - xOfDist(a))} height={(AMP + 10) * 2} />
    ))}

    <rect class="hover-band" x="0" y={CY - AMP - 6} width="0" height={(AMP + 6) * 2} />
    <line class="axis" x1={PADX} y1={CY} x2={W - PADX} y2={CY} />

    {sfBars.map((cx) => (
      <>
        <rect class="sf-ground" x={cx - SF_CELL} y={SF_TOP}
              width={SF_CELL * 2} height={SF_H} />
        {[0, 1].map((col) => (
          <line class="sf" x1={cx - SF_CELL / 2 + col * SF_CELL} y1={SF_TOP}
                x2={cx - SF_CELL / 2 + col * SF_CELL} y2={SF_TOP + SF_H}
                stroke-width={SF_CELL}
                stroke-dasharray={`${SF_CELL} ${SF_CELL}`}
                stroke-dashoffset={col === 0 ? 0 : SF_CELL} />
        ))}
        <rect class="sf-frame" x={cx - SF_CELL} y={SF_TOP}
              width={SF_CELL * 2} height={SF_H} />
      </>
    ))}
    <path class="ribbon" d={ribbon} />

    {cs.map((c) => (
      <line class="apex" x1={xOfDist(c.apex)} y1={CY - 3} x2={xOfDist(c.apex)} y2={CY + 3} />
    ))}

    <line class="hover-line" x1="0" y1={CY - AMP - 6} x2="0" y2={CY + AMP + 6} />


    {longest && (
      <text class="ann" x={labelX} y={14} text-anchor="middle">
        longest straight · {Math.round(longest.len)} m
      </text>
    )}
  </svg>

</figure>

<style>
  .profile { margin: 0; }
  .chart { display: block; width: 100%; height: auto; margin-top: 14px; overflow: visible; }

  .ribbon { fill: var(--ks-ink); fill-opacity: 0.1; stroke: var(--ks-ink); stroke-width: 1; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .axis   { stroke: var(--ks-edge); stroke-width: 1; vector-effect: non-scaling-stroke; }
  /* The ground and the white dashes cover the same area exactly, so any black
     showing at the edge is sub-pixel antialiasing — it appeared as a hairline
     of uneven width. An explicit frame makes it deliberate instead, and
     non-scaling-stroke holds it at 1px whatever the chart is scaled to. */
  .sf-ground { fill: #000; }
  .sf { stroke: #fff; }
  .sf-frame {
    fill: none; stroke: #000; stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }
  .apex   { stroke: var(--f1-corner); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .straight { fill: var(--ks-ink); fill-opacity: 0.05; }

  .ann  { font-family: var(--ks-mono), monospace; font-size: 11px; letter-spacing: .1em;
          text-transform: uppercase; fill: var(--ks-text-mute-deep); }

  .hover-band { fill: var(--ks-kinpaku); fill-opacity: 0; }
  .hover-line { stroke: var(--ks-kinpaku-deep); stroke-width: 1; opacity: 0;
                vector-effect: non-scaling-stroke; }
  .chart.is-hovering .hover-band { fill-opacity: .18; }
  .chart.is-hovering .hover-line { opacity: 1; }

</style>
