---
import type { GetStaticPaths } from 'astro';
import Base from '@layouts/Base.astro';
import Stat from '@components/Stat.astro';
import CircuitOutline from '@components/CircuitOutline.astro';
import TrackProfile from '@components/TrackProfile.astro';
import CircuitScatter from '@components/CircuitScatter.astro';
import TrackLink from '@components/TrackLink.astro';
import { circuits, circuit, outline, profile, racesAtCircuit, season,
         currentSeasonYear, seasonCircuits, startLine } from '@lib/data';
import { u } from '@lib/url';
import { km, shortDate, int, sentence, circuitType } from '@lib/format';

export const getStaticPaths = (() =>
  circuits().map((c) => ({ params: { id: c.id } }))) satisfies GetStaticPaths;

const c = circuit(Astro.params.id!)!;
const o = outline(c.id);
const prof = profile(c.id);
const thisSeason = currentSeasonYear();
const field = seasonCircuits(thisSeason);
const held = racesAtCircuit(c.id);
const winners = new Map<string, number>();
for (const r of held) {
  const w = season(r.year).results[String(r.round)]?.find((x) => x.posNum === 1);
  if (w) winners.set(w.driver, (winners.get(w.driver) ?? 0) + 1);
}
const topWinners = [...winners.entries()].sort((a, b) => b[1] - a[1]).slice(0, 5);
---
<Base title={c.name} description={`${c.fullName} — ${c.place}, ${c.country}.`}>
  <div class="wrap section" data-pagefind-body>
    <p class="eyebrow">Circuit · {c.country}</p>
    <h1 class="headline" style="margin-top:.3em">{c.name}</h1>
    <p class="lead muted" style="margin-top:.7em">{c.fullName}</p>

    {o ? (
      <>
      <div class="instrument viewport">
        <CircuitOutline
          outline={o} name={c.name} height={440} stroke={1.75}
          corners={prof?.corners ?? []} lapLength={prof?.length}
          showStart={prof?.startKnown ?? false}
          startFrac={startLine(c.id)}
        />
      </div>

      {prof && (
        <section class="profile-block">
          <h2 class="title-lg">Shape of a lap</h2>
          <TrackProfile profile={prof} name={c.name} />
          <TrackLink />
        </section>
      )}
      </>
    ) : (
      <div class="absence">
        <p class="title">No verified geometry</p>
        <p class="ui muted measure" style="margin-top:.5rem">
          This circuit has no outline here. Either no openly-licensed trace exists, or the
          one available disagreed with the recorded lap length by more than 5% — which
          usually means it traces a different configuration. A wrong outline is worse than
          none, so nothing is drawn.
        </p>
      </div>
    )}

    <hr class="rule" />
    <div class="stats">
      <Stat label="Lap length" value={km(c.length)} />
      <Stat label="Turns" value={c.turns ?? '—'} />
      <Stat label="Direction" value={sentence(c.direction)} />
      <Stat label="Type" value={circuitType(c.type)} />
      <Stat label="Grands Prix" value={int(c.racesHeld)} />
    </div>
    <hr class="rule" />

    {c.length != null && c.turns != null && (
      <section class="scatter-block">
        <h2 class="title-lg">Against the field</h2>
        <CircuitScatter field={field} current={c} season={thisSeason} />
      </section>
    )}

    <div class="two-up" style="margin-top:3.4rem">
      <section>
        <h2 class="title-lg">Grands Prix held</h2>
        <div class="table-scroll" style="margin-top:1rem">
          <table>
            <thead><tr><th class="n">Year</th><th>Grand Prix</th><th>Date</th><th>Winner</th></tr></thead>
            <tbody>
              {held.slice(0, 25).map((r) => {
                const w = season(r.year).results[String(r.round)]?.find((x) => x.posNum === 1);
                return (
                  <tr>
                    <td class="n"><a href={u(`/races/${r.year}/${r.round}/`)}>{r.year}</a></td>
                    <td>{r.shortName}</td>
                    <td class="num muted">{shortDate(r.date)}</td>
                    <td>{w?.driver ?? <span class="muted">—</span>}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        {held.length > 25 && (
          <p class="ui muted" style="margin-top:.9rem">
            Showing the 25 most recent of <span class="num">{held.length}</span>.
          </p>
        )}
      </section>

      <section>
        <h2 class="title-lg">Most wins here</h2>
        {topWinners.length ? (
          <div class="table-scroll" style="margin-top:1rem">
            <table>
              <thead><tr><th>Driver</th><th class="n">Wins</th></tr></thead>
              <tbody>
                {topWinners.map(([name, n]) => (
                  <tr><td>{name}</td><td class="n">{n}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : <p class="ui muted" style="margin-top:1rem">No races recorded.</p>}

        {o && (
          <p class="ui muted measure" style="margin-top:2rem">
            Geometry from {o.source.startsWith('TUMFTM')
              ? <><a href="https://github.com/TUMFTM/racetrack-database">TUMFTM/racetrack-database</a>,
                  derived from <a href="https://www.openstreetmap.org/copyright">© OpenStreetMap contributors</a> (ODbL)</>
              : o.source.startsWith('F1 timing')
                ? <>the Formula 1 timing feed</>
                : <a href="https://github.com/bacinger/f1-circuits">bacinger/f1-circuits</a>}
            · <span class="num">{o.spacing.toFixed(1)} m</span> between points
            · measures <span class="num">{(o.length / 1000).toFixed(3)} km</span> against
            a recorded <span class="num">{c.length?.toFixed(3)} km</span>.
            {prof && (prof.startSource === 'feed'
              ? <> Start/finish is taken from the timing feed.</>
              : prof.startSource === 'osm'
                ? <> Start/finish is taken from OpenStreetMap.</>
                : <> Start/finish is inferred from where the trace begins and may be
                    approximate.</>)}
          </p>
        )}
      </section>
    </div>
  </div>
</Base>

<style>
  .viewport {
    margin: 2.6rem 0 3rem; padding: clamp(24px, 4vw, 48px);
    display: flex; justify-content: center;
  }
  .viewport :global(svg) { color: var(--ks-instrument-text); }
  .profile-block { margin: 3.4rem 0; }
  .scatter-block { margin: 3.4rem 0; }
  .stats {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(148px, 1fr));
    gap: clamp(18px, 3vw, 32px); padding-block: 26px;
  }
  .two-up { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: clamp(28px, 4vw, 56px); }
  .absence { border-left: 1px solid var(--ks-edge); padding-left: 20px; margin: 2.6rem 0 3rem; }
</style>
