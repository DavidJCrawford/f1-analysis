---
import Base from '@layouts/Base.astro';
import CircuitOutline from '@components/CircuitOutline.astro';
import { circuits, outline, racesAtCircuit, seasons } from '@lib/data';
import { u } from '@lib/url';

const all = circuits()
  .map((c) => ({ c, o: outline(c.id), races: racesAtCircuit(c.id).length }))
  .sort((a, b) => b.races - a.races || a.c.name.localeCompare(b.c.name));
const withOutline = all.filter((x) => x.o);
const without = all.filter((x) => !x.o);
const year = seasons()[0]!.year;
---
<Base title="Circuits" description="Every circuit to have held a Formula 1 World Championship race.">
  <div class="wrap section" data-pagefind-body>
    <p class="eyebrow">Season {year}</p>
    <h1 class="headline" style="margin-top:.2em">Circuits</h1>
    <p class="lead" style="margin-top:1em">
      The {all.length} circuits on the {year} calendar, ordered by how often they have
      held a Grand Prix.
    </p>

    <div class="gallery" style="margin-top:3rem">
      {withOutline.map(({ c, o, races }) => (
        <a class="cell plain" href={u(`/circuits/${c.id}/`)}>
          <CircuitOutline outline={o!} name={c.name} height={110} />
          <span class="title">{c.name}</span>
          <span class="ui muted">{c.place}, {c.country}</span>
        </a>
      ))}
    </div>

    {without.length > 0 && (
      <section style="margin-top:4rem">
        <h2 class="title-lg">Without verified geometry</h2>
        <p class="ui muted measure" style="margin-top:.6rem">
          No outline is shown for these. Either no open geometry exists, or the available
          trace disagreed with the recorded circuit length by enough that the join could not
          be trusted — a wrong outline is worse than none.
        </p>
        <ul class="plainlist" style="margin-top:1.4rem">
          {without.map(({ c, races }) => (
            <li>
              <a href={u(`/circuits/${c.id}/`)}>{c.name}</a>
              <span class="ui muted"> — {c.place}, {c.country} · <span class="num">{races}</span></span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>

<style>
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(168px, 1fr)); gap: clamp(26px, 3vw, 44px); }
  .cell {
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    text-align: center; color: var(--ks-ink);
    transition: transform var(--ks-quick) var(--ks-ease);
  }
  .cell :global(svg) { margin-bottom: 6px; }
  .cell:hover { transform: translateY(-1px); }
  .plainlist { list-style: none; margin: 0; padding: 0; columns: 2; column-gap: 40px; }
  .plainlist li { break-inside: avoid; padding: 5px 0; }
</style>
