---
import Base from '@layouts/Base.astro';
import Stat from '@components/Stat.astro';
import CircuitOutline from '@components/CircuitOutline.astro';
import { counts, seasons, season, circuits, outline, meta } from '@lib/data';
import { u } from '@lib/url';
import { int, shortDate } from '@lib/format';

const c = counts();
const year = seasons()[0]!.year;
const s = season(year);
const m = meta();

const HERO = ['monza', 'spa-francorchamps', 'monaco', 'silverstone', 'suzuka', 'interlagos'];
const gallery = HERO
  .map((id) => ({ circuit: circuits().find((x) => x.id === id), outline: outline(id) }))
  .filter((h): h is { circuit: NonNullable<typeof h.circuit>; outline: NonNullable<typeof h.outline> } =>
    Boolean(h.circuit && h.outline));

const next = s.races.find((r) => r.date > m.dataAsOf);
const last = [...s.races].reverse().find((r) => r.date <= m.dataAsOf);
const leader = s.driverStandings[0];
const lastWinner = last
  ? (s.results[String(last.round)] ?? []).find((x) => x.posNum === 1)
  : undefined;
---
<Base title="F1 Analysis">
  <div class="wrap section">
    <p class="eyebrow">Formula 1 · Season {year}</p>
    <h1 class="display" style="margin-top:.2em">F1 Analysis</h1>
    <p class="lead" style="margin-top:1.2em">
      The {year} Formula 1 season, circuit by circuit. Every round and every track
      gets one designed page and one permanent URL, built from the official timing
      feed.
    </p>
  </div>

  <div class="wrap">
    <hr class="rule" />
    <div class="stats">
      <Stat label="Rounds" value={int(c.races)} />
      <Stat label="Run so far" value={int(c.held)} />
      <Stat label="Circuits" value={int(c.circuits)} />
      <Stat label="Teams" value={int(c.constructors)} />
      <Stat label="Classifications" value={int(c.results)} />
    </div>
    <hr class="rule" />
  </div>

  <section class="wrap section">
    <div class="three-up">
      <div>
        <h2 class="eyebrow">Championship</h2>
        {leader && (
          <p class="lead" style="margin-top:.8em">
            <strong>{leader.driver}</strong> leads on <span class="num">{leader.points}</span> points.{' '}
            <a href={u(`/seasons/${year}/`)}>Full standings</a>.
          </p>
        )}
      </div>

      <div>
        <h2 class="eyebrow">Last round</h2>
        {last ? (
          <p class="lead" style="margin-top:.8em">
            <a href={u(`/races/${year}/${last.round}/`)}>{last.shortName}</a>
            <span class="muted num"> · {shortDate(last.date)}</span>
            {lastWinner && (
              <><br /><span class="muted">Won by {lastWinner.driver}</span></>
            )}
          </p>
        ) : (
          <p class="lead muted" style="margin-top:.8em">The season has not started.</p>
        )}
      </div>

      <div>
        <h2 class="eyebrow">Next round</h2>
        {next ? (
          <p class="lead" style="margin-top:.8em">
            <a href={u(`/races/${year}/${next.round}/`)}>{next.shortName}</a>
            <span class="muted num"> · {shortDate(next.date)}</span>
          </p>
        ) : (
          <p class="lead muted" style="margin-top:.8em">The season is complete.</p>
        )}
      </div>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="eyebrow">Circuits</h2>
    <div class="circuit-row">
      {gallery.map(({ circuit, outline }) => (
        <a class="circuit-cell plain" href={u(`/circuits/${circuit.id}/`)}>
          <CircuitOutline outline={outline} name={circuit.name} height={104} />
          <span class="mono">{circuit.name}</span>
        </a>
      ))}
    </div>
    <p style="margin-top:2rem"><a href={u('/circuits/')}>All {c.circuits} circuits</a></p>
  </section>

  <section class="wrap section">
    <h2 class="title-lg">Built from the timing feed</h2>
    <p class="lead" style="margin-top:.8em">
      Circuit geometry, corner positions and start/finish lines come from Formula 1's
      own timing data rather than traced maps — so a corner is where the corner is,
      and the chequer is on the actual line.
    </p>
  </section>
</Base>

<style>
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: clamp(18px, 3vw, 40px); padding-block: 26px; }
  .three-up { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: clamp(24px, 4vw, 48px); }
  .circuit-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(18px, 3vw, 36px); margin-top: 1.4rem; }
  @media (width >= 560px) { .circuit-row { grid-template-columns: repeat(3, 1fr); } }
  @media (width >= 1000px) { .circuit-row { grid-template-columns: repeat(6, 1fr); } }
  .circuit-cell { display: flex; flex-direction: column; align-items: center; gap: 14px; color: var(--ks-ink); text-align: center; transition: transform var(--ks-quick) var(--ks-ease); }
  .circuit-cell:hover { transform: translateY(-1px); }
</style>
