---
import Base from '@layouts/Base.astro';
import Stat from '@components/Stat.astro';
import CircuitOutline from '@components/CircuitOutline.astro';
import { counts, seasons, season, seasonCircuits, outline, meta } from '@lib/data';
import { u } from '@lib/url';
import { int, shortDate } from '@lib/format';

const c = counts();
const year = seasons()[0]!.year;
const s = season(year);
const m = meta();

// In the order they are raced, so the gallery reads across as the season runs.
const allCircuits = seasonCircuits(year).map((x) => ({ c: x, o: outline(x.id) }));
const withOutline = allCircuits.filter((x) => x.o);
const without = allCircuits.filter((x) => !x.o);

const next = s.races.find((r) => r.date > m.dataAsOf);
const last = [...s.races].reverse().find((r) => r.date <= m.dataAsOf);
const leader = s.driverStandings[0];
const lastWinner = last
  ? (s.results[String(last.round)] ?? []).find((x) => x.posNum === 1)
  : undefined;
---
<Base title="F1 Analysis">
  <div class="wrap section">
    <p class="eyebrow">Formula 1 · Season {year}</p>
    <h1 class="display" style="margin-top:.2em">F1 Analysis</h1>
    <p class="lead" style="margin-top:1.2em">
      The {year} Formula 1 season, circuit by circuit. Every round and every track
      gets one designed page and one permanent URL, built from the official timing
      feed.
    </p>
  </div>

  <div class="wrap">
    <hr class="rule" />
    <div class="stats">
      <Stat label="Rounds" value={int(c.races)} />
      <Stat label="Run so far" value={int(c.held)} />
      <Stat label="Circuits" value={int(c.circuits)} />
      <Stat label="Teams" value={int(c.constructors)} />
      <Stat label="Classifications" value={int(c.results)} />
    </div>
    <hr class="rule" />
  </div>

  <section class="wrap section">
    <div class="three-up">
      <div>
        <h2 class="eyebrow">Championship</h2>
        {leader && (
          <p class="lead" style="margin-top:.8em">
            <strong>{leader.driver}</strong> leads on <span class="num">{leader.points}</span> points.{' '}
            <a href={u('/races/')}>Full standings</a>.
          </p>
        )}
      </div>

      <div>
        <h2 class="eyebrow">Last round</h2>
        {last ? (
          <p class="lead" style="margin-top:.8em">
            <a href={u(`/races/${year}/${last.round}/`)}>{last.shortName}</a>
            <span class="muted num"> · {shortDate(last.date)}</span>
            {lastWinner && (
              <><br /><span class="muted">Won by {lastWinner.driver}</span></>
            )}
          </p>
        ) : (
          <p class="lead muted" style="margin-top:.8em">The season has not started.</p>
        )}
      </div>

      <div>
        <h2 class="eyebrow">Next round</h2>
        {next ? (
          <p class="lead" style="margin-top:.8em">
            <a href={u(`/races/${year}/${next.round}/`)}>{next.shortName}</a>
            <span class="muted num"> · {shortDate(next.date)}</span>
          </p>
        ) : (
          <p class="lead muted" style="margin-top:.8em">The season is complete.</p>
        )}
      </div>
    </div>
  </section>

  <section class="wrap section" id="circuits" data-pagefind-body>
    <h2 class="title-lg">Circuits</h2>
    <p class="lead" style="margin-top:.8em">
      The {c.circuits} circuits on the {year} calendar, in the order they are raced.
    </p>

    <div class="gallery" style="margin-top:2.6rem">
      {withOutline.map(({ c: ci, o }) => (
        <a class="cell plain" href={u(`/circuits/${ci.id}/`)}>
          <CircuitOutline outline={o!} name={ci.name} height={110} />
          <span class="title">{ci.name}</span>
          <span class="ui muted">{ci.place}, {ci.country}</span>
        </a>
      ))}
    </div>

    {without.length > 0 && (
      <div style="margin-top:4rem">
        <h3 class="title">Without verified geometry</h3>
        <p class="ui muted measure" style="margin-top:.6rem">
          No outline is shown for these. Either no open geometry exists, or the available
          trace disagreed with the recorded circuit length by enough that the join could not
          be trusted — a wrong outline is worse than none.
        </p>
        <ul class="plainlist" style="margin-top:1.2rem">
          {without.map(({ c: ci }) => (
            <li>
              <a href={u(`/circuits/${ci.id}/`)}>{ci.name}</a>
              <span class="ui muted"> — {ci.place}, {ci.country}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
</Base>

<style>
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: clamp(18px, 3vw, 40px); padding-block: 26px; }
  .three-up { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: clamp(24px, 4vw, 48px); }
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(168px, 1fr)); gap: clamp(26px, 3vw, 44px); }
  .cell {
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    text-align: center; color: var(--ks-ink);
    transition: transform var(--ks-quick) var(--ks-ease);
  }
  .cell :global(svg) { margin-bottom: 6px; }
  .cell:hover { transform: translateY(-1px); }
  .plainlist { list-style: none; margin: 0; padding: 0; columns: 2; column-gap: 40px; }
  .plainlist li { break-inside: avoid; padding: 5px 0; }
  @media (prefers-reduced-motion: reduce) { .cell:hover { transform: none; } }
</style>
