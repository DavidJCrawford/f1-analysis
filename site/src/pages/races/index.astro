---
import Base from '@layouts/Base.astro';
import Stat from '@components/Stat.astro';
import { seasons, season, circuit, meta, counts, hasDriverPage, TIER_LABEL } from '@lib/data';
import TeamMark from '@components/TeamMark.astro';
import { u } from '@lib/url';
import { shortDate, pts } from '@lib/format';

const year = seasons()[0]!.year;
const s = season(year);
const index = seasons().find((x) => x.year === year)!;
const asOf = meta().dataAsOf;
const c = counts();
const decided = index.championDriver || index.championConstructor;
---
<Base title="Races" description={`Every round of the ${year} Formula 1 season, with both championships.`}>
  <div class="wrap section" data-pagefind-body>
    <p class="eyebrow">Season {year} · {TIER_LABEL[s.tier]} tier</p>
    <h1 class="headline" style="margin-top:.2em">Races</h1>
    <p class="lead" style="margin-top:1em">
      {c.races} rounds, {c.held} run so far.
    </p>

    {decided && (
      <>
        <hr class="rule" style="margin-top:2.4rem" />
        <div class="stats">
          <Stat label="Drivers' champion" value={index.championDriver ?? '—'} />
          <Stat label="Constructors' champion" value={index.championConstructor ?? '—'} />
        </div>
        <hr class="rule" />
      </>
    )}

    <div class="table-scroll" style="margin-top:2.4rem">
      <table>
        <thead>
          <tr>
            <th class="n">Rd</th><th>Grand Prix</th><th>Circuit</th>
            <th>Date</th><th>Winner</th><th>Constructor</th>
          </tr>
        </thead>
        <tbody>
          {s.races.map((r) => {
            const w = (s.results[String(r.round)] ?? []).find((x) => x.posNum === 1);
            const ci = circuit(r.circuitId);
            const future = r.date > asOf;
            return (
              <tr class={future ? 'future' : undefined}>
                <td class="n">{r.round}</td>
                <td><a href={u(`/races/${year}/${r.round}/`)}>{r.shortName}</a></td>
                <td>{ci ? <a href={u(`/circuits/${ci.id}/`)}>{ci.name}</a> : r.circuitId}</td>
                <td class="num muted">{shortDate(r.date)}</td>
                <td>{w?.driver ?? <span class="muted">{future ? 'not yet held' : '—'}</span>}</td>
                <td class="muted">{w ? <a href={u(`/teams/${w.constructorId}/`)}>{w.constructor}</a> : '—'}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <div class="two-up" style="margin-top:3.4rem">
      <section>
        <h2 class="title-lg">Drivers' championship</h2>
        <div class="table-scroll" style="margin-top:1rem">
          <table>
            <thead><tr><th class="n">Pos</th><th>Driver</th><th class="n">Points</th></tr></thead>
            <tbody>
              {s.driverStandings.slice(0, 12).map((d) => (
                <tr>
                  <td class="n">{d.pos}</td>
                  <td>
                    {hasDriverPage(d.driverId)
                      ? <a href={u(`/drivers/${d.driverId}/`)}>{d.driver}</a>
                      : d.driver}
                    {d.champion && <span class="crown" aria-label="Champion"> ●</span>}
                  </td>
                  <td class="n">{pts(d.points)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section>
        <h2 class="title-lg">Constructors' championship</h2>
        {s.constructorStandings.length ? (
          <div class="table-scroll" style="margin-top:1rem">
            <table>
              <thead><tr><th class="n">Pos</th><th>Constructor</th><th class="n">Points</th></tr></thead>
              <tbody>
                {s.constructorStandings.slice(0, 12).map((c) => (
                  <tr>
                    <td class="n">{c.pos}</td>
                    <td>
                      <a class="named" href={u(`/teams/${c.constructorId}/`)}>
                        <TeamMark id={c.constructorId} height={18} />{c.constructor}
                      </a>
                      {c.champion && <span class="crown" aria-label="Champion"> ●</span>}
                    </td>
                    <td class="n">{pts(c.points)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="ui muted measure" style="margin-top:1rem">
            No constructors' championship was awarded in {year}. It was first contested in 1958.
          </p>
        )}
      </section>
    </div>
  </div>
</Base>

<style>
  .named { display: inline-flex; align-items: center; gap: .55em; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: clamp(18px,3vw,40px); padding-block: 26px; }
  .two-up { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: clamp(28px, 4vw, 56px); }
  .crown { color: var(--ks-kinpaku); font-size: .7em; vertical-align: middle; }
  tr.future td { color: var(--ks-text-mute-deep); }
</style>
